# Copy to .env.nonprod / .env.prod and adjust. Agent does not auto-load —
# run: source .env.nonprod && go run .
#
# Two agents on one machine: use different SAILORPORT_WORKER_NAME and
# SAILORPORT_DEPLOY_PORT_BASE so ports do not collide.

export SAILORPORT_API_URL=http://localhost:8080
export SAILORPORT_AGENT_TOKEN=dev-agent-token
export SAILORPORT_WORKER_NAME=nonprod-01
export SAILORPORT_WORKER_TIER=nonprod
export SAILORPORT_WORKER_ENVIRONMENTS=dev,staging
export SAILORPORT_HEARTBEAT_INTERVAL=15s
export SAILORPORT_POLL_INTERVAL=5s
export SAILORPORT_DEPLOY_PORT_BASE=18080
export SAILORPORT_DEPLOY_PORT_COUNT=32
