# Copy ke deploy/compose/.env lalu isi. Compose menolak start kalau dua nilai
# di bawah kosong. File .env tidak ikut ter-commit (lihat .gitignore).
#
#   cp deploy/compose/.env.example deploy/compose/.env
#   openssl rand -hex 32   # jalankan dua kali, satu nilai per baris di bawah

# Secret penandatangan JWT portal. Siapa pun yang tahu ini bisa membuat
# token role=admin sendiri.
AUTH_JWT_SECRET=

# Shared token agent <-> API. Harus sama dengan SAILORPORT_AGENT_TOKEN di
# tiap node yang menjalankan apps/agent.
SAILORPORT_AGENT_TOKEN=

# AES-256 key untuk encrypt baris secret di service_catalog_env (openssl rand -hex 32).
# Wajib saat APP_ENV=production. Kosong di development = plaintext (backward compat).
SAILORPORT_SECRETS_KEY=

# Dua nilai di atas tetap wajib diisi apa pun APP_ENV-nya (compose yang minta).
# APP_ENV=production membuat API menolak start kalau nilainya masih sama dengan
# default dev di repo (dev-only-change-me / dev-agent-token).
APP_ENV=development
